# Frontend
FRONTEND_PORT=5173
API_BASE_URL=http://localhost:3000
FRONTEND_REFRESH_INTERVAL_MS=10000

# Backend
BACKEND_PORT=3000
ENABLED_PROVIDERS=manual
DEFAULT_PROVIDER=manual

# Manual provider
MANUAL_MESSAGE=HELLO VESTAFREE
MANUAL_POLL_INTERVAL_MS=2000

# Weather provider (required when weather is enabled)
WEATHER_CITY=
WEATHER_CONDITIONS=UNKNOWN
WEATHER_TEMP_F=
WEATHER_POLL_INTERVAL_MS=60000

# Flight provider (required when flight is enabled)
FLIGHT_NUMBER=
FLIGHT_STATUS=UNKNOWN
FLIGHT_GATE=TBD
FLIGHT_POLL_INTERVAL_MS=45000
